{
  "name": "recog-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strict TypeScript implementation of Rapid7 Recog: engine, REST API, MCP server.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "vitest run packages/core/test/corpus.spec.ts",
    "check:loc": "tsx scripts/check-loc.ts",
    "docs:api": "typedoc",
    "docs:build": "pnpm docs:api && cd docs && nuxt build",
    "start:api": "node packages/api/dist/bin/serve.js",
    "start:mcp": "node packages/mcp/dist/bin/serve.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typedoc": "^0.26.7",
    "typedoc-plugin-markdown": "^4.2.7",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
